#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Djerba OS — configuration live-build (appelée par « lb config »).
#
# Socle : Debian 13 « trixie » (main, contrib, non-free, non-free-firmware)
# amorcé par debootstrap. Noyau Debian 6.12 à préemption dynamique, réglé en
# préemption complète (« preempt=full ») pour une latence basse en jeu.
#
# Amorçage : EFI natif via « --bootloaders grub-efi » (shim + GRUB signés par
# Debian : Secure Boot), complété par grub-pc sur amd64 pour le BIOS hérité ;
# image iso-hybrid (CD/DVD ou clé USB).
#
# Variables d'environnement reconnues :
#   DJERBA_ARCH     amd64 | arm64     (défaut : architecture de l'hôte)
#   DJERBA_VERSION  version affichée dans l'ISO (défaut : AAAA.MM)
#   DJERBA_LOCALE   locale de la session live (défaut : fr_FR.UTF-8)
#   DJERBA_KEYMAP   disposition clavier live (défaut : fr)
set -euo pipefail

ARCH="${DJERBA_ARCH:-$(dpkg --print-architecture)}"
VERSION="${DJERBA_VERSION:-$(date -u +%Y.%m)}"
LOCALE="${DJERBA_LOCALE:-fr_FR.UTF-8}"
KEYMAP="${DJERBA_KEYMAP:-fr}"

AREAS="main contrib non-free non-free-firmware"
MIRROR="http://deb.debian.org/debian/"
MIRROR_SECURITY="http://security.debian.org/debian-security/"

case "${ARCH}" in
    amd64)
        BOOTLOADERS="grub-efi grub-pc"
        SERIAL_CONSOLE="ttyS0"
        ;;
    arm64)
        BOOTLOADERS="grub-efi"
        SERIAL_CONSOLE="ttyAMA0"
        ;;
    *)
        echo "auto/config : architecture non supportée « ${ARCH} »" >&2
        exit 1
        ;;
esac

# Console série en premier, tty0 en dernier : tty0 reste /dev/console (Plymouth
# graphique), tandis que systemd lance un getty sur le port série (tests QEMU
# headless et serveurs sans écran).
BOOTAPPEND="boot=live components quiet splash preempt=full"
BOOTAPPEND="${BOOTAPPEND} username=djerba user-fullname=Djerba hostname=djerba"
BOOTAPPEND="${BOOTAPPEND} locales=${LOCALE} keyboard-layouts=${KEYMAP}"
BOOTAPPEND="${BOOTAPPEND} console=${SERIAL_CONSOLE},115200n8 console=tty0"

lb config noauto \
    --mode debian \
    --system live \
    --architecture "${ARCH}" \
    --distribution trixie \
    --archive-areas "${AREAS}" \
    --parent-archive-areas "${AREAS}" \
    --mirror-bootstrap "${MIRROR}" \
    --mirror-chroot "${MIRROR}" \
    --mirror-chroot-security "${MIRROR_SECURITY}" \
    --mirror-binary "${MIRROR}" \
    --mirror-binary-security "${MIRROR_SECURITY}" \
    --security true \
    --updates true \
    --backports false \
    --proposed-updates false \
    --apt-recommends false \
    --apt-source-archives false \
    --apt-indices true \
    --apt-options "--yes -o Acquire::Retries=10 -o Acquire::http::Timeout=60 -o Acquire::https::Timeout=60" \
    --cache true \
    --cache-packages true \
    --cache-indices false \
    --cache-stages bootstrap \
    --initsystem systemd \
    --initramfs live-boot \
    --linux-packages linux-image \
    --linux-flavours "${ARCH}" \
    --firmware-chroot false \
    --firmware-binary false \
    --debian-installer none \
    --memtest none \
    --win32-loader false \
    --loadlin false \
    --binary-images iso-hybrid \
    --bootloaders "${BOOTLOADERS}" \
    --uefi-secure-boot enable \
    --bootappend-live "${BOOTAPPEND}" \
    --chroot-filesystem squashfs \
    --chroot-squashfs-compression-type zstd \
    --image-name djerba-os \
    --iso-application "Djerba OS ${VERSION}" \
    --iso-publisher "Djerba OS; https://github.com/dc92jnrvg8-lang/distrib-djerba" \
    --iso-preparer "live-build; Djerba OS builder" \
    --iso-volume "DJERBA_OS" \
    --hdd-label "DJERBA_OS" \
    --checksums sha256 \
    --zsync false \
    --source false \
    "${@}"
