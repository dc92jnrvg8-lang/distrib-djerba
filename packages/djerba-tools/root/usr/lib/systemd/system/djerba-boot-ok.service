# Djerba OS — démarrage réussi : remet à zéro le compteur de GRUB et
# rafraîchit le dernier bon état (@djerba-last-good). Attend la fin du
# démarrage (systemctl is-system-running --wait) sans délai fixe : un
# démarrage lent n'est pas un échec. Type=simple : jamais sur le chemin
# critique (le démarrage ne l'attend pas).
[Unit]
Description=Djerba : validation du démarrage (rollback au démarrage)
ConditionPathIsMountPoint=/boot/efi
After=multi-user.target djerba-boot-guard.service

[Service]
Type=simple
ExecStart=/usr/libexec/djerba-boot ok --wait
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
