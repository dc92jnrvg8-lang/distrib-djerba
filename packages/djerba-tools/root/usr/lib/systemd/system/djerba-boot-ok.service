# Djerba OS — démarrage réussi : remet à zéro le compteur de GRUB et
# rafraîchit le dernier bon état (@djerba-last-good). Lancé par sa minuterie,
# trois minutes après l'amorçage : jamais sur le chemin critique.
[Unit]
Description=Djerba : démarrage réussi (rollback au démarrage)
ConditionPathIsMountPoint=/boot/efi
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/djerba-boot ok
Nice=10
IOSchedulingClass=idle
