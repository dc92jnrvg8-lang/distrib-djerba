#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Djerba OS — mode discret : apparence de bureau façon Windows, réversible
# (même principe que le mode « undercover » de Kali Linux), pour travailler en
# public sans attirer l'attention.
#
# Usage : djerba-undercover [on|off|toggle|status] [--style 10|11]
#
#   on       sauvegarde la configuration Plasma de l'utilisateur, puis applique
#            le thème global « Discret » : couleurs claires, accent bleu, fond
#            bleu, barre des tâches en bas, alignée à gauche (--style 10) ou
#            centrée (--style 11, par défaut)
#   off      restaure exactement la configuration sauvegardée
#   toggle   bascule (action du lanceur « Mode discret »)
#   status   affiche l'état courant
#
# Commande utilisateur : elle ne modifie que ~/.config, jamais le système.
set -euo pipefail

readonly STATE="${XDG_DATA_HOME:-${HOME}/.local/share}/djerba-undercover"
readonly BACKUP="${STATE}/backup"
readonly CONFIG="${XDG_CONFIG_HOME:-${HOME}/.config}"
readonly FILES=(
    kdeglobals kwinrc plasmarc plasmashellrc
    plasma-org.kde.plasma.desktop-appletsrc
    kcminputrc ksplashrc kscreenlockerrc gtk-3.0/settings.ini gtk-4.0/settings.ini
)

STYLE="11"

log() { printf '[mode discret] %s\n' "$*"; }
die() { printf '[mode discret] %s\n' "$*" >&2; exit 1; }

notify() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send --app-name="Djerba OS" --icon=djerba-os "Mode discret" "$1" || true
    fi
}

active() {
    [[ -f "${STATE}/active" ]]
}

backup_config() {
    rm -rf "${BACKUP}"
    mkdir -p "${BACKUP}"
    local file
    for file in "${FILES[@]}"; do
        if [[ -f "${CONFIG}/${file}" ]]; then
            mkdir -p "$(dirname "${BACKUP}/${file}")"
            cp -a "${CONFIG}/${file}" "${BACKUP}/${file}"
        else
            mkdir -p "$(dirname "${BACKUP}/${file}")"
            : > "${BACKUP}/${file}.absent"
        fi
    done
}

restore_config() {
    [[ -d "${BACKUP}" ]] || die "aucune sauvegarde à restaurer"
    local file
    for file in "${FILES[@]}"; do
        if [[ -f "${BACKUP}/${file}" ]]; then
            mkdir -p "$(dirname "${CONFIG}/${file}")"
            cp -a "${BACKUP}/${file}" "${CONFIG}/${file}"
        elif [[ -f "${BACKUP}/${file}.absent" ]]; then
            rm -f "${CONFIG}/${file}"
        fi
    done
}

refresh_session() {
    # Relit la palette de couleurs, recharge KWin et relance le bureau.
    local scheme
    scheme="$(kreadconfig6 --file kdeglobals --group General --key ColorScheme --default BreezeDark)"
    plasma-apply-colorscheme "${scheme}" >/dev/null 2>&1 || true
    if command -v qdbus6 >/dev/null 2>&1; then
        qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || true
    else
        dbus-send --session --type=method_call --dest=org.kde.KWin /KWin org.kde.KWin.reconfigure \
            >/dev/null 2>&1 || true
    fi
    systemctl --user restart plasma-plasmashell.service
}

turn_on() {
    active && { log "déjà actif"; return 0; }
    local package
    case "${STYLE}" in
        10) package="org.djerba.undercover10.desktop" ;;
        11) package="org.djerba.undercover11.desktop" ;;
        *) die "style inconnu : ${STYLE} (10 ou 11)" ;;
    esac
    mkdir -p "${STATE}"
    backup_config
    log "application du thème discret (style ${STYLE})"
    plasma-apply-lookandfeel --apply "${package}" --resetLayout
    echo "${STYLE}" > "${STATE}/active"
    notify "Activé : l'apparence du bureau est passée en mode discret. Relancez la commande pour revenir."
}

turn_off() {
    active || { log "déjà inactif"; return 0; }
    log "restauration de votre configuration"
    restore_config
    rm -f "${STATE}/active"
    refresh_session
    notify "Désactivé : votre bureau habituel est restauré."
}

main() {
    local command="${1:-toggle}"
    shift || true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --style) STYLE="${2:?--style attend 10 ou 11}"; shift 2 ;;
            *) die "option inconnue : $1" ;;
        esac
    done
    [[ "${EUID}" -ne 0 ]] || die "à lancer en tant qu'utilisateur (pas en root)"
    case "${command}" in
        on) turn_on ;;
        off) turn_off ;;
        toggle) if active; then turn_off; else turn_on; fi ;;
        status) if active; then echo "Mode discret : actif (style $(cat "${STATE}/active"))"; else echo "Mode discret : inactif"; fi ;;
        -h|--help) sed -n '6,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
        *) die "commande inconnue : ${command} (voir --help)" ;;
    esac
}

main "$@"
