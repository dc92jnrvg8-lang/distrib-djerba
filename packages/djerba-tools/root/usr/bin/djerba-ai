#!/usr/bin/python3 -I
# SPDX-License-Identifier: GPL-3.0-or-later
"""djerba-ai — l'agent IA de Djerba OS.

Point d'entrée signé : exécuté par l'interpréteur système en mode isolé (-I),
son empreinte figure dans /usr/share/djerba-ai/trusted-callers.sha256 ; le
démon root n'accepte les actions sensibles que de lui.

Usage :
    djerba-ai [--page chat|system|selfheal|studio|tools|settings] application graphique (mode Studio)
    djerba-ai --hud                   anneau d'action contextuel (Super+Espace)
    djerba-ai --spotlight             barre flottante
    djerba-ai --ask "demande"         ouvre la barre et pose la question
    djerba-ai --ask-file ACTION F…    action sur des fichiers (Dolphin, Nautilus)
    djerba-ai --ask-selection C NOM   consigne sur la sélection lue sur stdin (Kate, Gedit)
    djerba-ai --clipboard             analyse du presse-papiers (Meta+Maj+C)
    djerba-ai --tray                  démarrage résident (zone de notification)
    djerba-ai ask "demande"           discussion en terminal (confirmation o/n des actions)
    djerba-ai tools [recherche]       capacités disponibles
    djerba-ai run OUTIL ['{"param": …}'] [--verbose]
                                      exécute une capacité (JSON des paramètres)
    djerba-ai health                  bilan de santé
    djerba-ai doctor                  diagnostic : moteur d'IA, démon root, outils manquants
    djerba-ai run-app SLUG [--live]   lance une application du Studio
    djerba-ai daemon                  démon utilisateur (service djerba-ai.service)
    djerba-ai transactions [N]        dernières modifications du système (journal du démon root)
    djerba-ai undo ID [--force]       annule une modification (restauration depuis la sauvegarde)
    djerba-ai undo --since DATE       annule tout depuis DATE (AAAA-MM-JJ[THH:MM]), du plus récent
                                      au plus ancien
    djerba-ai engines                 moteurs d'IA configurés (actif, capacité mesurée)
    djerba-ai engines add TYPE ID [--endpoint URL] [--model M] [--name NOM]
                                      TYPE : ollama, openai, gemini, anthropic, openai_compat
                                      (clé d'API demandée au clavier, transmise au démon root)
    djerba-ai engines pair-jarvis ADRESSE CODE [ID]
                                      appairage avec Jarvis (code à 6 chiffres affiché par Jarvis)
    djerba-ai engines use|test|measure|remove ID
    djerba-ai mcp pair NOM [--cap 0-2] | list | revoke NOM
                                      Djerba serveur d'outils pour un assistant distant (Jarvis)
    djerba-ai mcp-serve               serveur MCP (service djerba-ai-mcp.service)
    djerba-ai pause [raison]          disjoncteur : l'agent n'effectue plus aucune modification
    djerba-ai resume                  reprise (authentification administrateur)
    djerba-ai policy [prudent|autonome|total]
                                      état de la politique, ou changement de mode (administrateur)
    djerba-ai rollback --make-permanent
                                      conserve le système restauré au démarrage (après deux
                                      démarrages ratés, GRUB revient au dernier bon état)
    djerba-ai session-report gnome [unité]
                                      rapport de plantage de la session GNOME
                                      (/var/log/djerba/gnome-crash.log), lancé par systemd
"""

from __future__ import annotations

import json
import os
import subprocess
import sys

CHILD = "DJERBA_AI_CHILD"


def gui(argv: list[str]) -> int:
    # Instance déjà résidente : la demande lui est transmise (ouverture immédiate).
    from djerba_ai.gui import instance
    if "--ask-selection" in argv or "--ask-file" in argv:
        stdin_text = sys.stdin.read() if "--ask-selection" in argv and not sys.stdin.isatty() else ""
        argv = instance.request_from_application(argv, stdin_text)
    if instance.forward(argv):
        return 0
    # Sans accélération 3D fiable (VM, framebuffer), rendu logiciel d'emblée (orbe 2D).
    # Si le rendu accéléré plante malgré tout, l'interface est relancée en logiciel.
    if CHILD not in os.environ:
        from djerba_ai.core import gpu
        if not gpu.detect()["accelerated"]:
            os.environ["QT_QUICK_BACKEND"] = "software"
        attempts = [dict(os.environ, **{CHILD: "1"})]
        if os.environ.get("QT_QUICK_BACKEND") != "software":
            attempts.append(dict(os.environ, **{CHILD: "1", "QT_QUICK_BACKEND": "software"}))
        code = 1
        for environment in attempts:
            code = subprocess.call([sys.executable, "-I", os.path.abspath(__file__), *argv], env=environment)
            if code >= 0:
                return code
            print(f"djerba-ai : rendu interrompu (signal {-code}) ; nouvel essai en rendu logiciel.", file=sys.stderr)
        return 128 - code
    from djerba_ai.gui.app import main
    return main([sys.argv[0], *argv])


def ask(request: str) -> int:
    from djerba_ai.core.agent import Agent
    from djerba_ai.core.config import Config
    from djerba_ai.core.memory import Memory
    from djerba_ai.tools import registry

    config = Config()
    memory = Memory()
    agent = Agent(config, registry(include_plugins=True, approved=config.get("agent.plugins_approved")), memory)
    conversation = memory.new_conversation(request[:60])

    def on_event(kind: str, payload: dict) -> None:
        if kind == "token":
            print(payload["text"], end="", flush=True)
        elif kind == "tool_start":
            print(f"\n\033[36m▶ {payload['label']}\033[0m", flush=True)
        elif kind == "tool_result":
            result = payload["result"]
            mark = "\033[32m✓" if result.get("success") else "\033[31m✗"
            print(f"{mark} {result.get('message', '')}\033[0m", flush=True)
        elif kind == "final" and payload.get("degraded"):
            print(payload["text"])

    def confirm(tool: str, params: dict, description: dict) -> bool:
        root = " (mot de passe administrateur)" if description.get("requires_root") else ""
        answer = input(f"\n\033[33mDjerba souhaite : {description.get('description')} {json.dumps(params, ensure_ascii=False)}"
                       f"{root}. Autoriser ? [o/N] \033[0m")
        return answer.strip().lower() in ("o", "oui", "y", "yes")

    agent.run(request, conversation, on_event, confirm)
    print()
    return 0


def tools(query: str) -> int:
    from djerba_ai.tools import CATEGORY_LABELS, registry
    reg = registry()
    selection = reg.search(query, limit=40) if query else sorted(reg.tools.values(), key=lambda t: (t.category, t.name))
    for tool in selection:
        flags = ("R" if tool.requires_root else "-") + ("!" if tool.dangerous else "-") \
            + ("x" if tool.missing_binaries() else "-")
        print(f"{flags} {tool.name:<26} {CATEGORY_LABELS[tool.category]:<13} {tool.description}")
    print(f"\n{len(selection)} / {len(reg)} capacités  (R : administrateur, ! : confirmation, x : outil manquant)")
    return 0


def run(name: str, raw: str, verbose: bool) -> int:
    from djerba_ai.core.executor import Executor
    from djerba_ai.core.memory import Memory
    from djerba_ai.tools import registry
    try:
        params = json.loads(raw) if raw else {}
    except ValueError:
        print("djerba-ai : paramètres JSON invalides", file=sys.stderr)
        return 2
    result = Executor(registry(), Memory()).execute(name, params, request=f"[terminal] {name}", verbose=verbose)
    print(json.dumps(result, ensure_ascii=False, indent=2))
    return 0 if result.get("success") else 1


def transactions(limit: int) -> int:
    from djerba_ai.core import ipc
    try:
        items = ipc.call("tx.list", {"limit": limit}, timeout=60)["transactions"]
    except ipc.RPCError as exc:
        print(f"Journal indisponible : {exc}", file=sys.stderr)
        return 1
    if not items:
        print("Aucune modification enregistrée.")
    for item in reversed(items):
        origin = " · ".join(part for part in (item.get("engine"), f"session {item['session']}"
                                              if item.get("session") else "") if part)
        changes = len(item.get("changes") or {})
        print(f"{item['id']}  {item['started'][:16].replace('T', ' ')}  {item['state']:<24} "
              f"{item.get('tool') or item['method']}  ({changes} fichier(s)"
              + (f", {origin}" if origin else "") + ")")
    return 0


def undo(argv: list[str]) -> int:
    from djerba_ai.core import ipc
    try:
        if argv[:1] == ["--since"] and len(argv) >= 2:
            result = ipc.call("tx.undo_since", {"since": argv[1]}, timeout=3600)
            for error in result.get("errors", []):
                print(f"  - {error}")
        elif argv and not argv[0].startswith("-"):
            result = ipc.call("tx.undo", {"id": argv[0], "force": "--force" in argv}, timeout=3600)
        else:
            print("Usage : djerba-ai undo ID [--force] | djerba-ai undo --since AAAA-MM-JJ[THH:MM]", file=sys.stderr)
            return 2
    except ipc.RPCError as exc:
        print(f"Annulation impossible : {exc}", file=sys.stderr)
        return 1
    print(result["message"])
    return 0 if result.get("success") else 1


def policy_command(argv: list[str]) -> int:
    from djerba_ai.core import ipc
    command = argv[0] if argv else "policy"
    try:
        if command == "pause":
            result = ipc.call("policy.pause", {"reason": " ".join(argv[1:])[:200]}, timeout=60)
        elif command == "resume":
            result = ipc.call("policy.resume", {}, timeout=330)
        elif len(argv) > 1 and argv[1] in ("prudent", "autonome", "total"):
            result = ipc.call("policy.set_mode", {"mode": argv[1]}, timeout=330)
        else:
            status = ipc.call("policy.status", {}, timeout=60)
            print(f"Mode : {status['mode']}" + (f" — EN PAUSE depuis {status['paused']['since']}"
                                                if status.get("paused") else ""))
            print(f"Plafonds : {status['limits']['par_minute']} actions/min par session, "
                  f"{status['limits']['par_dix_minutes']} en 10 min, même action {status['limits']['repetitions']}"
                  " fois/h au plus")
            for refusal in status.get("refusals", [])[-10:]:
                print(f"  refus {refusal['time'][:16]} {refusal['tool']} (niveau {refusal['level']}) : "
                      f"{refusal['reason']}")
            return 0
    except ipc.RPCError as exc:
        print(f"Impossible : {exc}", file=sys.stderr)
        return 1
    print(result.get("message", ""))
    return 0 if result.get("success") else 1


def engines_command(argv: list[str]) -> int:
    import getpass
    from djerba_ai.core import engines, ipc
    from djerba_ai.core.config import Config
    config = Config()
    action = argv[1] if len(argv) > 1 else "list"
    options = {argv[index][2:]: argv[index + 1] for index in range(len(argv) - 1) if argv[index].startswith("--")}
    try:
        if action == "list":
            active = engines.active_id(config)
            for engine in engines.catalog(config):
                label = (engine.get("profile") or {}).get("label", "capacité non mesurée")
                print(f"{'●' if engine['id'] == active else ' '} {engine['id']:<14} {engine['name']:<28} "
                      f"{engines.KIND_LABELS.get(engine['kind'], engine['kind']):<22} {engine.get('model', ''):<24} "
                      f"{label}")
            return 0
        if action == "add" and len(argv) >= 4:
            kind, identifier = argv[2], argv[3]
            spec = {"id": identifier, "kind": kind, "name": options.get("name") or engines.KIND_LABELS.get(kind, kind),
                    "endpoint": options.get("endpoint", ""), "model": options.get("model") or
                    engines.DEFAULT_MODELS.get(kind, ""), "context_window": 128000 if kind != "ollama" else 8192}
            secret = getpass.getpass("Clé d'API (laisser vide si aucune) : ") if kind != "ollama" else ""
            result = ipc.call("engines.save", {"engine": spec, "secret": secret}, timeout=330)
            print(result["message"])
            return 0 if result.get("success") else 1
        if action == "pair-jarvis" and len(argv) >= 4:
            result = ipc.call("engines.pair_jarvis", {"address": argv[2], "code": argv[3],
                                                      "id": argv[4] if len(argv) > 4 else "jarvis"}, timeout=330)
            print(result["message"])
            return 0 if result.get("success") else 1
        if action in ("use", "test", "measure", "remove") and len(argv) >= 3:
            engine = engines.find(argv[2], config)
            if engine is None:
                print(f"Moteur inconnu : {argv[2]}", file=sys.stderr)
                return 1
            if action == "use":
                config.set("llm.engine", engine["id"])
                print(f"Moteur actif : {engine['name']}")
                return 0
            if action == "remove":
                print(ipc.call("engines.remove", {"id": engine["id"]}, timeout=330)["message"])
                return 0
            provider = engines.make_provider(engine, config)
            if action == "test":
                health = provider.health(10)
                print(f"{engine['name']} : {health.get('detail')} ({health.get('latency_ms', 0)} ms)")
                return 0 if health.get("ok") else 1
            profile = engines.measure(provider)
            print(f"{engine['name']} : {profile['label']}")
            if not engine.get("builtin"):
                ipc.call("engines.set_profile", {"id": engine["id"], "profile": profile}, timeout=330)
            return 0 if profile.get("reachable") else 1
    except ipc.RPCError as exc:
        print(f"Impossible : {exc}", file=sys.stderr)
        return 1
    print(__doc__, file=sys.stderr)
    return 2


def mcp_command(argv: list[str]) -> int:
    from djerba_ai.core import ipc, mcp
    from djerba_ai.core.config import Config
    action = argv[1] if len(argv) > 1 else "list"
    try:
        if action == "pair" and len(argv) >= 3:
            cap = int(argv[argv.index("--cap") + 1]) if "--cap" in argv else 2
            result = ipc.call("mcp.pair_begin", {"name": argv[2], "cap": cap}, timeout=330)
            address = mcp.bind_address() or "<adresse Tailscale>"
            link = f"djerba-mcp://{address}:{Config().get('mcp.port')}?code={result['code']}"
            print(f"Code d'appairage pour « {argv[2]} » : {result['code']} (valable "
                  f"{result['expires_in'] // 60} min)\n{link}")
            try:
                import qrcode  # python3-qrcode (recommandé)
                code = qrcode.QRCode(border=1)
                code.add_data(link)
                code.print_ascii(invert=True)
            except ImportError:
                pass
            return 0
        if action == "list":
            for client in ipc.call("mcp.list", {}, timeout=60)["clients"]:
                print(f"{client['client']:<20} plafond {client['cap']}  dernier appel : {client.get('last_used') or '—'}")
            return 0
        if action == "revoke" and len(argv) >= 3:
            result = ipc.call("mcp.revoke", {"client": argv[2]}, timeout=330)
            print(result["message"])
            return 0 if result.get("success") else 1
    except ipc.RPCError as exc:
        print(f"Impossible : {exc}", file=sys.stderr)
        return 1
    print(__doc__, file=sys.stderr)
    return 2


def health() -> int:
    from djerba_ai.core.health import report
    result = report()
    print(f"Score de santé : {result['score']}/100")
    for item in result["items"]:
        mark = {"ok": "\033[32m✓", "warning": "\033[33m!", "error": "\033[31m✗"}[item["level"]]
        print(f"{mark} {item['title']}\033[0m — {item['detail']}")
    return 0


def doctor() -> int:
    from djerba_ai.core import ipc
    from djerba_ai.core.config import Config
    from djerba_ai.core.llm import client_from_config
    from djerba_ai.tools import registry
    config = Config()
    client = client_from_config(config)
    health = client.health(5)
    print(f"Cerveau : {config.get('llm.provider')} ({health.get('label')}) — {health.get('detail')}"
          f" (modèle « {health.get('model')} », {health.get('latency_ms')} ms)")
    if health.get("fallback") is not None:
        print(f"Repli   : Ollama local — {'prêt' if health['fallback'].get('ok') else 'indisponible'}")
    from djerba_ai.core import gpu
    print(f"Rendu   : {gpu.detect()['reason']}")
    try:
        print(f"Démon root : disponible (version {ipc.call('sys.ping', {}, timeout=10)['version']})")
    except ipc.RPCError as exc:
        print(f"Démon root : {exc}")
    reg = registry()
    missing = {tool.name: tool.missing_binaries() for tool in reg.tools.values() if tool.missing_binaries()}
    print(f"Capacités : {len(reg)} ({len(reg) - len(missing)} utilisables)")
    for name, binaries in sorted(missing.items()):
        print(f"  - {name} : {', '.join(binaries)} manquant")
    return 0


def main() -> int:
    argv = sys.argv[1:]
    command = argv[0] if argv and not argv[0].startswith("-") else ""
    if argv[:1] in (["-h"], ["--help"]):
        print(__doc__)
        return 0
    if not command:
        return gui(argv)
    if command == "ask" and len(argv) >= 2:
        return ask(" ".join(argv[1:]))
    if command == "tools":
        return tools(" ".join(argv[1:]))
    if command == "run" and len(argv) >= 2:
        verbose = "--verbose" in argv or "-v" in argv
        rest = [arg for arg in argv[2:] if arg not in ("--verbose", "-v")]
        return run(argv[1], rest[0] if rest else "", verbose)
    if command == "health":
        return health()
    if command == "transactions":
        return transactions(int(argv[1]) if len(argv) > 1 and argv[1].isdigit() else 30)
    if command == "undo":
        return undo(argv[1:])
    if command in ("pause", "resume", "policy"):
        return policy_command(argv)
    if command == "engines":
        return engines_command(argv)
    if command == "mcp":
        return mcp_command(argv)
    if command == "mcp-serve":
        from djerba_ai.core import mcp
        from djerba_ai.core.config import Config
        return mcp.serve(Config())
    if command == "rollback" and "--make-permanent" in argv:
        os.execvp("pkexec", ["pkexec", "/usr/libexec/djerba-boot", "make-permanent"])
    if command == "doctor":
        return doctor()
    if command == "run-app" and len(argv) >= 2:
        from djerba_ai.tools.devtools import run_app
        return run_app(argv[1], live="--live" in argv)
    if command == "daemon":
        from djerba_ai.core.daemon import main as daemon_main
        return daemon_main()
    if command == "session-report" and len(argv) >= 2 and argv[1] == "gnome":
        from djerba_ai.ui.session_guard import collect_gnome
        return collect_gnome(argv[2] if len(argv) > 2 else "")
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
