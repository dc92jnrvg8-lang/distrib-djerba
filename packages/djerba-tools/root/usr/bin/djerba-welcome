#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Djerba Welcome — assistant d'accueil et de premier démarrage (PyQt6 + QML).

Usage :
    djerba-welcome [--page home|apps|gaming|privacy|system]
    djerba-welcome --install     lance directement l'installateur Calamares

Pages :
    Accueil          installation (session live) ; suivi de l'installation des
                     applications choisies dans l'installateur (premier démarrage)
    Applications     catalogue Djerba (Steam, Lutris, Heroic…) : djerba-apps
    Jeu              mode jeu de la session, MangoHud, lanceurs : djerba-gamemode
    Confidentialité  mode anonyme Tor (djerba-anonsurf), mode discret
                     (djerba-undercover), antivirus, pare-feu
    Système          matériel détecté, mises à jour

L'interface s'exécute dans un processus enfant supervisé : si le rendu
accéléré échoue (pilote OpenGL défaillant, machine virtuelle sans
accélération 3D…), l'assistant se relance automatiquement avec le moteur de
rendu logiciel de QtQuick et une interface sans effets de shader.

Les actions privilégiées passent par pkexec et les actions polkit
org.djerba.installer, org.djerba.apps et org.djerba.anonsurf.
"""

from __future__ import annotations

import configparser
import json
import os
import platform
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

os.environ.setdefault("QT_ENABLE_HIGHDPI_SCALING", "1")
os.environ.setdefault("QT_QUICK_CONTROLS_STYLE", "Basic")
if os.environ.get("WAYLAND_DISPLAY") and "QT_QPA_PLATFORM" not in os.environ:
    os.environ["QT_QPA_PLATFORM"] = "wayland;xcb"

from PyQt6.QtCore import (  # noqa: E402 - l'environnement Qt doit être défini avant
    QDir,
    QLockFile,
    QObject,
    QProcess,
    QSize,
    QStandardPaths,
    QTimer,
    Qt,
    QUrl,
    pyqtProperty,
    pyqtSignal,
    pyqtSlot,
)
from PyQt6.QtGui import QDesktopServices, QFont, QGuiApplication, QIcon, QPixmap  # noqa: E402
from PyQt6.QtQml import QQmlApplicationEngine  # noqa: E402
from PyQt6.QtQuick import QQuickImageProvider  # noqa: E402

APP_ID = "djerba-welcome"
SHARE_DIR = Path(os.environ.get("DJERBA_WELCOME_SHARE", "/usr/share/djerba-welcome"))
ASSETS_DIR = Path(os.environ.get("DJERBA_ASSETS", "/usr/share/djerba/assets"))
QML_FILE = SHARE_DIR / "ui" / "main.qml"
WALLPAPER = Path("/usr/share/wallpapers/Djerba/contents/images/1920x1080.png")
CALAMARES = "/usr/bin/calamares"
PROJECT_URL = "https://github.com/dc92jnrvg8-lang/distrib-djerba"
CHILD_ENV = "DJERBA_WELCOME_CHILD"
PAGES = ("home", "apps", "gaming", "privacy", "system")

NM_STATE_CONNECTED_GLOBAL = 70

# Lanceurs de la page Jeu : identifiant -> (libellé, commande, icône, description)
GAME_LAUNCHERS = [
    ("steam", "Steam", ["steam"], "steam", "Boutique et bibliothèque Steam"),
    ("steam-bp", "Steam Big Picture", ["steam", "-gamepadui"], "steam", "Interface manette plein écran, façon SteamOS"),
    ("lutris", "Lutris", ["lutris"], "lutris", "GOG, Epic, Battle.net, émulateurs"),
    ("heroic", "Heroic", ["flatpak", "run", "com.heroicgameslauncher.hgl"], "com.heroicgameslauncher.hgl", "Epic Games, GOG, Amazon"),
    ("protonup", "ProtonUp-Qt", ["flatpak", "run", "net.davidotek.pupgui2"], "net.davidotek.pupgui2", "Proton-GE et Wine-GE"),
    ("goverlay", "GOverlay", ["goverlay"], "goverlay", "Réglages de MangoHud et vkBasalt"),
]


def is_live_session() -> bool:
    """Vrai si le système tourne depuis le média live (live-boot)."""
    try:
        cmdline = Path("/proc/cmdline").read_text(encoding="utf-8").split()
    except OSError:
        cmdline = []
    return "boot=live" in cmdline or Path("/run/live/medium").is_dir()


def read_cpu_model() -> str:
    try:
        for line in Path("/proc/cpuinfo").read_text(encoding="utf-8").splitlines():
            key, _, value = line.partition(":")
            if key.strip() in {"model name", "Model", "Hardware"} and value.strip():
                return value.strip()
    except OSError:
        pass
    try:
        output = subprocess.run(["lscpu"], capture_output=True, text=True, check=False, timeout=5).stdout
        for line in output.splitlines():
            if line.startswith("Model name:"):
                return line.split(":", 1)[1].strip()
    except (OSError, subprocess.SubprocessError):
        pass
    return platform.processor() or platform.machine()


def read_memory() -> str:
    try:
        for line in Path("/proc/meminfo").read_text(encoding="utf-8").splitlines():
            if line.startswith("MemTotal:"):
                kib = int(line.split()[1])
                return f"{kib / 1024 / 1024:.1f} Gio"
    except (OSError, ValueError, IndexError):
        pass
    return "inconnue"


def read_gpus() -> str:
    if not shutil.which("lspci"):
        return "inconnu"
    try:
        output = subprocess.run(["lspci", "-mm"], capture_output=True, text=True, check=False, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return "inconnu"
    gpus = []
    for line in output.splitlines():
        # Format « lspci -mm » : emplacement "classe" "fabricant" "modèle" -rXX -pXX "…"
        try:
            fields = shlex.split(line)
        except ValueError:
            continue
        if len(fields) >= 4 and any(kind in fields[1] for kind in ("VGA", "3D", "Display")):
            gpus.append(f"{fields[2]} {fields[3]}".strip())
    return " · ".join(gpus) if gpus else "intégré"


def read_os() -> str:
    try:
        for line in Path("/etc/os-release").read_text(encoding="utf-8").splitlines():
            if line.startswith("PRETTY_NAME="):
                return line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return "Djerba OS"


def read_firmware() -> str:
    return "UEFI" if Path("/sys/firmware/efi").is_dir() else "BIOS hérité"


def run_json(command: list[str], timeout: float = 10) -> dict:
    """Exécute une commande d'état Djerba et décode sa sortie JSON."""
    try:
        output = subprocess.run(command, capture_output=True, text=True, check=False,
                                timeout=timeout).stdout
        return json.loads(output.strip().splitlines()[-1]) if output.strip() else {}
    except (OSError, subprocess.SubprocessError, ValueError, IndexError):
        return {}


# Icônes du thème : nom logique -> noms freedesktop essayés dans l'ordre.
ICON_FALLBACKS = {
    "cpu": ["cpu", "preferences-devices-cpu", "computer"],
    "memory": ["memory", "media-flash", "computer"],
    "gpu": ["video-display", "preferences-desktop-display", "computer"],
    "kernel": ["preferences-system", "system-run", "computer"],
    "firmware": ["computer", "preferences-system"],
    "os": ["djerba-os", "computer"],
}


class IconProvider(QQuickImageProvider):
    """Expose les icônes du thème (Breeze) au QML via « image://icon/<nom> »."""

    def __init__(self) -> None:
        super().__init__(QQuickImageProvider.ImageType.Pixmap)

    def requestPixmap(self, icon_id: str, requested_size: QSize) -> tuple[QPixmap, QSize]:
        size = requested_size if requested_size.isValid() and not requested_size.isEmpty() else QSize(64, 64)
        icon = QIcon()
        for name in ICON_FALLBACKS.get(icon_id, [icon_id]) + ["application-x-executable"]:
            icon = QIcon.fromTheme(name)
            if not icon.isNull():
                break
        pixmap = icon.pixmap(size)
        if pixmap.isNull():
            pixmap = QPixmap(size)
            pixmap.fill(Qt.GlobalColor.transparent)
        return pixmap, pixmap.size()


class Backend(QObject):
    """Pont entre l'interface QML et le système."""

    networkChanged = pyqtSignal()
    autostartChanged = pyqtSignal()
    installerStateChanged = pyqtSignal()
    appsChanged = pyqtSignal()
    appsBusyChanged = pyqtSignal()
    appsProgress = pyqtSignal(str, int, int, arguments=["message", "done", "total"])
    appsFinished = pyqtSignal(bool, str, arguments=["success", "message"])
    pendingChanged = pyqtSignal()
    gamingChanged = pyqtSignal()
    privacyChanged = pyqtSignal()
    publicIpChanged = pyqtSignal()
    privacyBusyChanged = pyqtSignal()
    notify = pyqtSignal(str, arguments=["message"])

    def __init__(self, start_page: str, parent: QObject | None = None) -> None:
        super().__init__(parent)
        self._live = is_live_session()
        self._start_page = start_page
        self._online = False
        self._installer_running = False
        self._config_path = Path(
            QStandardPaths.writableLocation(QStandardPaths.StandardLocation.GenericConfigLocation)
        ) / "djerba-welcomerc"
        self._system_info = [
            {"label": "Système", "value": read_os(), "icon": "os"},
            {"label": "Processeur", "value": read_cpu_model(), "icon": "cpu"},
            {"label": "Mémoire", "value": read_memory(), "icon": "memory"},
            {"label": "Graphique", "value": read_gpus(), "icon": "gpu"},
            {"label": "Noyau", "value": platform.release(), "icon": "kernel"},
            {"label": "Micrologiciel", "value": read_firmware(), "icon": "firmware"},
        ]
        self._apps: list = []
        self._categories: list = []
        self._apps_busy = False
        self._apps_process: QProcess | None = None
        self._apps_buffer = ""
        self._pending: list = []
        self._pending_message = ""
        self._gaming: dict = {}
        self._privacy: dict = {}
        self._undercover = False
        self._public_ip = ""
        self._via_tor = False
        self._privacy_busy = False

        self._timer = QTimer(self)
        self._timer.setInterval(4000)
        self._timer.timeout.connect(self._poll)
        self._timer.start()
        QTimer.singleShot(0, self._poll)
        QTimer.singleShot(0, self.refreshApps)

    # ------------------------------------------------------------------ État général
    @pyqtProperty(bool, constant=True)
    def isLive(self) -> bool:
        return self._live

    @pyqtProperty(str, constant=True)
    def startPage(self) -> str:
        return self._start_page

    @pyqtProperty(bool, constant=True)
    def softwareRendering(self) -> bool:
        return os.environ.get("QT_QUICK_BACKEND") == "software"

    @pyqtProperty(str, constant=True)
    def edition(self) -> str:
        return "Session live" if self._live else "Système installé"

    @pyqtProperty("QVariantList", constant=True)
    def systemInfo(self) -> list:
        return self._system_info

    @pyqtProperty(str, constant=True)
    def wallpaper(self) -> str:
        return QUrl.fromLocalFile(str(WALLPAPER)).toString() if WALLPAPER.is_file() else ""

    @pyqtProperty(str, constant=True)
    def assetsUrl(self) -> str:
        return QUrl.fromLocalFile(str(ASSETS_DIR)).toString() + "/"

    @pyqtProperty(bool, notify=networkChanged)
    def online(self) -> bool:
        return self._online

    @pyqtProperty(bool, notify=installerStateChanged)
    def installerRunning(self) -> bool:
        return self._installer_running

    def _read_autostart(self) -> bool:
        parser = configparser.ConfigParser(interpolation=None)
        parser.optionxform = str
        parser.read(self._config_path, encoding="utf-8")
        return parser.get("General", "Autostart", fallback="true").lower() == "true"

    @pyqtProperty(bool, notify=autostartChanged)
    def autostart(self) -> bool:
        return self._read_autostart()

    @autostart.setter
    def autostart(self, enabled: bool) -> None:
        parser = configparser.ConfigParser(interpolation=None)
        parser.optionxform = str
        parser.read(self._config_path, encoding="utf-8")
        if not parser.has_section("General"):
            parser.add_section("General")
        parser.set("General", "Autostart", "true" if enabled else "false")
        self._config_path.parent.mkdir(parents=True, exist_ok=True)
        with self._config_path.open("w", encoding="utf-8") as handle:
            parser.write(handle, space_around_delimiters=False)
        self.autostartChanged.emit()

    # ------------------------------------------------------------------ Sondages
    def _poll(self) -> None:
        self._refresh_network()
        gaming = run_json(["djerba-gamemode", "status", "--json"]) if shutil.which("djerba-gamemode") else {}
        if gaming != self._gaming:
            self._gaming = gaming
            self.gamingChanged.emit()
        privacy = run_json(["djerba-anonsurf", "status", "--json"]) if shutil.which("djerba-anonsurf") else {}
        undercover = (Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share"))
                      / "djerba-undercover" / "active").exists()
        if privacy != self._privacy or undercover != self._undercover:
            self._privacy = privacy
            self._undercover = undercover
            self.privacyChanged.emit()
        if not self._live and shutil.which("djerba-apps"):
            status = run_json(["djerba-apps", "status", "--json"])
            pending = list((status.get("pending") or {}).get("install") or [])
            current = status.get("current") or {}
            message = current.get("message", "") if pending else ""
            if pending != self._pending or message != self._pending_message:
                was_pending = bool(self._pending)
                self._pending = pending
                self._pending_message = message
                self.pendingChanged.emit()
                if was_pending and not pending:
                    self.refreshApps()

    def _refresh_network(self) -> None:
        online = False
        try:
            import dbus  # python3-dbus

            bus = dbus.SystemBus()
            proxy = bus.get_object("org.freedesktop.NetworkManager", "/org/freedesktop/NetworkManager")
            state = proxy.Get("org.freedesktop.NetworkManager", "State",
                              dbus_interface="org.freedesktop.DBus.Properties")
            online = int(state) >= NM_STATE_CONNECTED_GLOBAL
        except Exception:  # noqa: BLE001 - absence de bus/NM : considéré hors ligne
            online = False
        if online != self._online:
            self._online = online
            self.networkChanged.emit()

    # ------------------------------------------------------------------ Installateur
    @pyqtSlot()
    def launchInstaller(self) -> None:
        if not Path(CALAMARES).exists():
            self.notify.emit("L'installateur Calamares est introuvable sur ce système.")
            return
        if self._installer_running:
            self.notify.emit("L'installateur est déjà ouvert.")
            return
        process = QProcess(self)
        process.setProgram("pkexec")
        process.setArguments([CALAMARES])
        process.finished.connect(self._installer_finished)
        process.errorOccurred.connect(lambda _error: self._installer_finished())
        process.start()
        self._installer_running = True
        self.installerStateChanged.emit()

    def _installer_finished(self, *_args) -> None:
        self._installer_running = False
        self.installerStateChanged.emit()

    # ------------------------------------------------------------------ Applications
    @pyqtProperty("QVariantList", notify=appsChanged)
    def apps(self) -> list:
        return self._apps

    @pyqtProperty("QVariantList", notify=appsChanged)
    def categories(self) -> list:
        return self._categories

    @pyqtProperty(bool, notify=appsBusyChanged)
    def appsBusy(self) -> bool:
        return self._apps_busy

    @pyqtProperty("QVariantList", notify=pendingChanged)
    def pendingApps(self) -> list:
        return self._pending

    @pyqtProperty(str, notify=pendingChanged)
    def pendingMessage(self) -> str:
        return self._pending_message

    @pyqtSlot()
    def refreshApps(self) -> None:
        if not shutil.which("djerba-apps"):
            return
        data = run_json(["djerba-apps", "list", "--json"], timeout=30)
        self._apps = [app for app in data.get("apps", []) if app.get("supported", True)]
        self._categories = data.get("categories", [])
        self.appsChanged.emit()

    @pyqtSlot("QVariantList", bool)
    def changeApps(self, ids: list, remove: bool) -> None:
        ids = [str(app_id) for app_id in ids]
        if not ids or self._apps_busy:
            return
        process = QProcess(self)
        process.setProgram("pkexec")
        process.setArguments(["/usr/bin/djerba-apps", "remove" if remove else "install", *ids,
                              "--json-progress"])
        process.setProcessChannelMode(QProcess.ProcessChannelMode.SeparateChannels)
        process.readyReadStandardOutput.connect(self._apps_output)
        process.finished.connect(self._apps_done)
        self._apps_process = process
        self._apps_buffer = ""
        self._apps_busy = True
        self.appsBusyChanged.emit()
        self.appsProgress.emit("Autorisation…", 0, len(ids))
        process.start()

    def _apps_output(self) -> None:
        if self._apps_process is None:
            return
        self._apps_buffer += bytes(self._apps_process.readAllStandardOutput()).decode(errors="replace")
        while "\n" in self._apps_buffer:
            line, self._apps_buffer = self._apps_buffer.split("\n", 1)
            try:
                event = json.loads(line)
            except ValueError:
                continue
            self.appsProgress.emit(event.get("message", ""), int(event.get("done", 0)), int(event.get("total", 0)))

    def _apps_done(self, exit_code: int, _status) -> None:
        self._apps_busy = False
        self.appsBusyChanged.emit()
        messages = {
            0: (True, "Terminé."),
            75: (False, "Aucune connexion Internet : réessayez une fois connecté."),
            126: (False, "Autorisation refusée."),
            127: (False, "Autorisation refusée."),
        }
        success, message = messages.get(exit_code, (False, "Terminé avec des erreurs."))
        self.appsFinished.emit(success, message)
        self.refreshApps()

    # ------------------------------------------------------------------ Jeu
    @pyqtProperty(bool, notify=gamingChanged)
    def gameModeActive(self) -> bool:
        return bool(self._gaming.get("active"))

    @pyqtProperty(bool, notify=gamingChanged)
    def mangohudEnabled(self) -> bool:
        return bool(self._gaming.get("mangohud"))

    @pyqtProperty(str, notify=gamingChanged)
    def powerProfile(self) -> str:
        names = {"performance": "Performances", "balanced": "Équilibré", "power-saver": "Économie"}
        profile = self._gaming.get("power_profile", "")
        return names.get(profile, profile or "inconnu")

    @pyqtProperty("QVariantList", constant=True)
    def gameLaunchers(self) -> list:
        launchers = []
        for launcher_id, label, command, icon, description in GAME_LAUNCHERS:
            if command[0] == "flatpak":
                available = Path(f"/var/lib/flatpak/app/{command[2]}").is_dir()
            else:
                available = shutil.which(command[0]) is not None
            launchers.append({"id": launcher_id, "label": label, "icon": icon,
                              "description": description, "available": available})
        return launchers

    @pyqtSlot()
    def toggleGameMode(self) -> None:
        self._run_detached_then_poll(["djerba-gamemode", "toggle"])

    @pyqtSlot(bool)
    def setMangohud(self, enabled: bool) -> None:
        self._run_detached_then_poll(["djerba-gamemode", "mangohud", "on" if enabled else "off"])

    @pyqtSlot(str)
    def launchGame(self, launcher_id: str) -> None:
        for known_id, label, command, _icon, _description in GAME_LAUNCHERS:
            if known_id == launcher_id:
                QProcess.startDetached(command[0], command[1:])
                self.notify.emit(f"Lancement de {label}…")
                return

    # ------------------------------------------------------------------ Confidentialité
    @pyqtProperty(bool, notify=privacyChanged)
    def anonActive(self) -> bool:
        return bool(self._privacy.get("active"))

    @pyqtProperty(int, notify=privacyChanged)
    def anonBootstrap(self) -> int:
        try:
            return int(self._privacy.get("bootstrap", 0))
        except (TypeError, ValueError):
            return 0

    @pyqtProperty(bool, notify=privacyChanged)
    def undercoverActive(self) -> bool:
        return self._undercover

    @pyqtProperty(bool, notify=privacyBusyChanged)
    def privacyBusy(self) -> bool:
        return self._privacy_busy

    @pyqtProperty(str, notify=publicIpChanged)
    def publicIp(self) -> str:
        return self._public_ip

    @pyqtProperty(bool, notify=publicIpChanged)
    def viaTor(self) -> bool:
        return self._via_tor

    def _set_privacy_busy(self, busy: bool) -> None:
        self._privacy_busy = busy
        self.privacyBusyChanged.emit()

    @pyqtSlot()
    def toggleAnonSurf(self) -> None:
        if self._privacy_busy:
            return
        self._set_privacy_busy(True)
        process = QProcess(self)
        process.finished.connect(lambda code, _s: self._anon_done(code))
        process.start("pkexec", ["/usr/bin/djerba-anonsurf", "toggle"])

    def _anon_done(self, code: int) -> None:
        self._set_privacy_busy(False)
        self._public_ip = ""
        self.publicIpChanged.emit()
        if code not in (0,):
            self.notify.emit("Le mode anonyme n'a pas pu changer d'état (voir la notification).")
        self._poll()

    @pyqtSlot()
    def newIdentity(self) -> None:
        QProcess.startDetached("pkexec", ["/usr/bin/djerba-anonsurf", "change"])

    @pyqtSlot()
    def checkIp(self) -> None:
        process = QProcess(self)
        process.finished.connect(lambda _c, _s: self._ip_done(process))
        self._public_ip = "vérification…"
        self.publicIpChanged.emit()
        process.start("djerba-anonsurf", ["myip", "--json"])

    def _ip_done(self, process: QProcess) -> None:
        try:
            data = json.loads(bytes(process.readAllStandardOutput()).decode())
            self._public_ip = str(data.get("IP", "inconnue"))
            self._via_tor = bool(data.get("IsTor"))
        except ValueError:
            self._public_ip = "indisponible"
            self._via_tor = False
        self.publicIpChanged.emit()

    @pyqtSlot(str)
    def setUndercover(self, style: str) -> None:
        if style == "off":
            self._run_detached_then_poll(["djerba-undercover", "off"])
        else:
            self._run_detached_then_poll(["djerba-undercover", "on", "--style", style])

    # ------------------------------------------------------------------ Outils
    def _run_detached_then_poll(self, command: list[str]) -> None:
        process = QProcess(self)
        process.finished.connect(lambda _c, _s: self._poll())
        process.start(command[0], command[1:])

    @pyqtSlot(str)
    def openTool(self, tool: str) -> None:
        commands = {
            "antivirus": ["clamtk"],
            "firewall": ["systemsettings", "kcm_firewall"],
            "updates": ["plasma-discover", "--mode", "update"],
            "discover": ["plasma-discover"],
            "settings": ["systemsettings"],
            "themes": ["systemsettings", "kcm_lookandfeel"],
        }
        command = commands.get(tool)
        if command and shutil.which(command[0]):
            QProcess.startDetached(command[0], command[1:])
        else:
            self.notify.emit("Cet outil n'est pas installé.")

    @pyqtSlot(str)
    def openUrl(self, url: str) -> None:
        QDesktopServices.openUrl(QUrl(url))

    @pyqtSlot()
    def openProject(self) -> None:
        QDesktopServices.openUrl(QUrl(PROJECT_URL))


def run_installer_only() -> int:
    """Mode « --install » : démarre Calamares via polkit et rend la main."""
    if not Path(CALAMARES).exists():
        print("djerba-welcome : Calamares est introuvable.", file=sys.stderr)
        return 1
    return subprocess.call(["pkexec", CALAMARES])


def supervise() -> int:
    """Lance l'interface dans un processus enfant ; en cas de plantage du rendu
    accéléré (fin sur signal), la relance avec le rendu logiciel de QtQuick."""
    command = [sys.executable, os.path.abspath(__file__), *sys.argv[1:]]
    attempts = [dict(os.environ, **{CHILD_ENV: "1"})]
    if os.environ.get("QT_QUICK_BACKEND") != "software":
        attempts.append(dict(os.environ, **{CHILD_ENV: "1", "QT_QUICK_BACKEND": "software"}))
    code = 1
    for environment in attempts:
        code = subprocess.call(command, env=environment)
        if code >= 0:
            return code
        print(f"djerba-welcome : rendu interrompu par le signal {-code} ; "
              "nouvel essai avec le rendu logiciel.", file=sys.stderr)
    return 128 - code


def start_page(argv: list[str]) -> str:
    if "--page" in argv:
        index = argv.index("--page")
        if index + 1 < len(argv) and argv[index + 1] in PAGES:
            return argv[index + 1]
    return "home"


def main() -> int:
    if "--install" in sys.argv[1:]:
        return run_installer_only()
    if CHILD_ENV not in os.environ:
        return supervise()

    QGuiApplication.setApplicationName(APP_ID)
    QGuiApplication.setApplicationDisplayName("Bienvenue dans Djerba OS")
    QGuiApplication.setDesktopFileName(APP_ID)
    QGuiApplication.setOrganizationName("Djerba OS")
    app = QGuiApplication(sys.argv)
    app.setWindowIcon(QIcon.fromTheme(APP_ID, QIcon(str(ASSETS_DIR / "logo.svg"))))
    app.setFont(QFont("Inter", 10))
    if not QIcon.themeName() or QIcon.themeName() == "hicolor":
        QIcon.setThemeName("breeze-dark")

    runtime_dir = QStandardPaths.writableLocation(QStandardPaths.StandardLocation.RuntimeLocation) or QDir.tempPath()
    lock = QLockFile(str(Path(runtime_dir) / f"{APP_ID}.lock"))
    lock.setStaleLockTime(0)
    if not lock.tryLock(100):
        print("djerba-welcome est déjà en cours d'exécution.", file=sys.stderr)
        return 0

    backend = Backend(start_page(sys.argv[1:]), app)
    engine = QQmlApplicationEngine()
    icon_provider = IconProvider()
    engine.addImageProvider("icon", icon_provider)
    engine.rootContext().setContextProperty("backend", backend)
    engine.load(QUrl.fromLocalFile(str(QML_FILE)))
    if not engine.rootObjects():
        print(f"djerba-welcome : impossible de charger {QML_FILE}", file=sys.stderr)
        return 1
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
