<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Djerba OS — actions de l'agent IA, vérifiées par djerba-ai-sysd pour le
     processus appelant (SO_PEERCRED). -->
<policyconfig>
  <vendor>Djerba OS</vendor>
  <vendor_url>https://github.com/dc92jnrvg8-lang/distrib-djerba</vendor_url>

  <action id="org.djerba.ai.exec">
    <description>Let the Djerba AI agent administer the system</description>
    <description xml:lang="fr">Autoriser l'agent Djerba à administrer le système</description>
    <message>Djerba needs administrator rights for this action</message>
    <message xml:lang="fr">Djerba a besoin des droits administrateur pour cette action</message>
    <icon_name>djerba-ai</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="org.djerba.ai.patch">
    <description>Test a fix proposed by the Djerba AI agent in its sandbox</description>
    <description xml:lang="fr">Tester dans le bac à sable un correctif proposé par l'agent Djerba</description>
    <message>Authentication is required to test a fix in the sandbox</message>
    <message xml:lang="fr">Une authentification est nécessaire pour tester un correctif dans le bac à sable</message>
    <icon_name>djerba-ai</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="org.djerba.ai.deploy">
    <description>Deploy or roll back a fix to a Djerba OS tool</description>
    <description xml:lang="fr">Déployer ou annuler un correctif d'un outil de Djerba OS</description>
    <message>Authentication is required to change a system tool</message>
    <message xml:lang="fr">Une authentification est nécessaire pour modifier un outil du système</message>
    <icon_name>djerba-ai</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.djerba.ai.setup">
    <description>Install the local AI engine (Ollama)</description>
    <description xml:lang="fr">Installer le moteur d'IA local (Ollama)</description>
    <message>Authentication is required to install the AI engine</message>
    <message xml:lang="fr">Une authentification est nécessaire pour installer le moteur d'IA</message>
    <icon_name>djerba-ai</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="org.djerba.ai.configure">
    <description>Change the Djerba AI agent configuration</description>
    <description xml:lang="fr">Modifier la configuration de l'agent Djerba</description>
    <message>Authentication is required to change Djerba's configuration (/etc/djerba/config.toml)</message>
    <message xml:lang="fr">Une authentification est nécessaire pour modifier la configuration de Djerba (/etc/djerba/config.toml)</message>
    <icon_name>djerba-ai</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="org.djerba.ai.cloud">
    <description>Use the online AI service configured for Djerba</description>
    <description xml:lang="fr">Utiliser le service d'IA en ligne configuré pour Djerba</description>
    <message>Authentication is required to use the online AI service</message>
    <message xml:lang="fr">Une authentification est nécessaire pour utiliser le service d'IA en ligne</message>
    <icon_name>djerba-ai</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="org.djerba.ai.audit">
    <description>Read the Djerba AI agent audit log</description>
    <description xml:lang="fr">Lire le journal d'audit de l'agent Djerba</description>
    <message>Authentication is required to read Djerba's audit log</message>
    <message xml:lang="fr">Une authentification est nécessaire pour lire le journal d'audit de Djerba</message>
    <icon_name>djerba-ai</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="org.djerba.ai.extend">
    <description>Test a capability written by the Djerba AI agent in its sandbox</description>
    <description xml:lang="fr">Tester dans le bac à sable une capacité écrite par l'agent Djerba</description>
    <message>Authentication is required to test a new capability</message>
    <message xml:lang="fr">Une authentification est nécessaire pour tester une nouvelle capacité</message>
    <icon_name>djerba-ai</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
  <action id="org.djerba.ai.undo">
    <description>Undo a change made to the system</description>
    <description xml:lang="fr">Annuler une modification du système</description>
    <message>Authentication is required to undo a change made to the system</message>
    <message xml:lang="fr">Une authentification est nécessaire pour annuler une modification du système</message>
    <icon_name>edit-undo</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

</policyconfig>
