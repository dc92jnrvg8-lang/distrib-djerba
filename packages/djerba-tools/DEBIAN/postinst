#!/bin/sh
# Djerba OS — djerba-tools : active le service de premier démarrage, la socket
# du démon root de l'agent Djerba et son démon utilisateur.
set -e

case "$1" in
    configure)
        mkdir -p /var/lib/djerba/apps
        systemctl enable djerba-apps-firstboot.service >/dev/null 2>&1 || true
        systemctl enable djerba-ai-sysd.socket >/dev/null 2>&1 || true
        systemctl --global enable djerba-ai.service >/dev/null 2>&1 || true
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
            systemctl start djerba-ai-sysd.socket >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
