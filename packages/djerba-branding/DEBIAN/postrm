#!/bin/sh
# Djerba OS — djerba-branding : restaure /usr/lib/os-release de base-files.
set -e

undivert() {
    dpkg-divert --package djerba-branding --remove --rename --divert "$1.debian" "$1" >/dev/null
}

case "$1" in
    remove|abort-install|disappear)
        undivert /usr/lib/os-release
        ;;
esac

exit 0
