# Djerba OS — socle système (Debian 13 « trixie »).
# Format natif live-build : un paquet par ligne, « #if VARIABLE valeur »
# évalué contre la configuration (auto/config), sans imbrication.
# Le noyau (linux-image-amd64 / -arm64) est installé par --linux-flavours.

# --- Micrologiciels (non-free-firmware) ---------------------------------------
# Liste explicite et reproductible : graphiques, Wi-Fi, Bluetooth et audio
# des matériels courants. Les paquets « *-installer » (téléchargement au
# moment de l'installation) sont volontairement exclus.
firmware-linux
firmware-misc-nonfree
firmware-amd-graphics
firmware-intel-graphics
firmware-nvidia-graphics
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-brcm80211
firmware-mediatek
firmware-libertas
firmware-ti-connectivity
firmware-sof-signed
firmware-intel-sound
firmware-cirrus
bluez-firmware

# --- Session live ------------------------------------------------------------
live-boot
live-config
live-config-systemd
live-tools
# Recommandations de live-config indispensables avec --apt-recommends false :
# user-setup crée l'utilisateur live (composant user-setup).
user-setup
iproute2
squashfs-tools
rsync
initramfs-tools
sudo
locales
tzdata
console-setup
keyboard-configuration

# --- Amorçage UEFI (requis par Calamares pour installer GRUB sur la cible) ---
efibootmgr
os-prober
shim-signed
#if ARCHITECTURES amd64
grub-efi-amd64
grub-efi-amd64-signed
grub-pc-bin
intel-microcode
amd64-microcode
#endif
#if ARCHITECTURES arm64
grub-efi-arm64
grub-efi-arm64-signed
#endif

# --- Stockage ------------------------------------------------------------------
btrfs-progs
e2fsprogs
xfsprogs
dosfstools
exfatprogs
ntfs-3g
gdisk
parted
fdisk
cryptsetup
cryptsetup-initramfs
smartmontools

# --- Mémoire, énergie et performances -----------------------------------------
zram-tools
irqbalance
power-profiles-daemon

# --- Démarrage graphique -----------------------------------------------------
plymouth
plymouth-label

# --- Réseau --------------------------------------------------------------------
network-manager
wpasupplicant
iw
wireless-regdb
bluez
systemd-resolved
libnss-resolve
systemd-timesyncd
iputils-ping
curl
ca-certificates
gnupg

# --- Sécurité et confidentialité -----------------------------------------------
apparmor
apparmor-utils
apparmor-profiles
ufw
nftables
unattended-upgrades
apt-listchanges
tor
torsocks
macchanger

# --- Antivirus -------------------------------------------------------------------
clamav
clamav-freshclam
clamtk

# --- Matériel graphique --------------------------------------------------------
libgl1-mesa-dri
mesa-vulkan-drivers
mesa-va-drivers
libvulkan1
vulkan-tools
#if ARCHITECTURES amd64
intel-media-va-driver
#endif

# --- Outils de base --------------------------------------------------------------
dbus-user-session
libpam-systemd
polkitd
pkexec
pciutils
usbutils
bash-completion
nano
less
python3
python3-yaml
python3-dbus
xdg-utils
libnotify-bin
